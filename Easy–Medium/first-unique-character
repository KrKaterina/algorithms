/*
---------------------------------------- First Unique Character--------------------------------------
Κουκκίδα Εκφώνηση: Δίνεται ένα string s με πεζούς αγγλικούς χαρακτήρες. 
Βρες το index του πρώτου χαρακτήρα που δεν επαναλαμβάνεται πουθενά αλλού στο string.
Αν δεν υπάρχει, επέστρεψε -1.

Κουκκίδα Είσοδος: s = "loveleetcode"
Κουκκίδα Έξοδος: 2 (ο χαρακτήρας 'v' εμφανίζεται μόνο μία φορά και είναι ο πρώτος τέτοιος χαρακτήρας).
Κουκκίδα Constraints: 1 \le \text{s.length} \le 10^5
Κουκκίδα Ζητούμενη Πολυπλοκότητα: O(n) χρόνος, O(1) χώρος
------------------------------------------------------------------------------------------------------
*/

public static int firstUniqChar(String s) {

    int[] freq = new int[26];

    for (int i = 0; i < s.length(); i++) {
        freq[s.charAt(i) - 'a']++;
    }

    for (int i = 0; i < s.length(); i++) {
        if (freq[s.charAt(i) - 'a'] == 1) {
            return i;
        }
    }

    return -1;
}


public static int firstUniqChar(String s) {

    Map<Character, Integer> m = new HashMap<>();

    for (int i = 0; i < s.length(); i++) {
        m.put(s.charAt(i),
              m.getOrDefault(s.charAt(i), 0) + 1);
    }

    for (int i = 0; i < s.length(); i++) {
        if (m.get(s.charAt(i)) == 1) {
            return i;
        }
    }

    return -1;
}
